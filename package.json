{
  "name": "john-js",
  "productName": "John",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "John - top-down 2D roguelite, JavaScript port of the Unity project.",
  "author": "Ylber Galica",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pixi.js": "^8.6.6",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.ylbergalica.john",
    "productName": "John",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "artifactName": "${productName}-${version}-win.${ext}"
    }
  }
}
