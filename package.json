{
  "name": "john-js",
  "productName": "Starspite",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "John - top-down 2D roguelite, JavaScript port of the Unity project.",
  "author": "Ylber Galica",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:win:demo": "vite build --mode demo && electron-builder --win -c.directories.output=release-demo -c.win.artifactName=${productName}-Demo-${version}-win.${ext}",
    "icon": "electron build/icon.mjs"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pixi.js": "^8.6.6",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.ylbergalica.starspite",
    "productName": "Starspite",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "dir",
        "zip"
      ],
      "artifactName": "${productName}-${version}-win.${ext}"
    }
  }
}
